# "mock" = in-memory demo data (default, no backend needed). "http" = talk to the real backend.
VITE_API_MODE=mock
# Where the dev server proxies /api and /ws in http mode
VITE_BACKEND_URL=http://localhost:4000
# Optional: absolute API base in production builds (otherwise same-origin /api)
VITE_API_URL=
# Optional: browser key for the interactive Google map (restrict by HTTP referrer). Without it a simple fallback map is shown.
VITE_GOOGLE_MAPS_API_KEY=
