# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./event.db
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# Google Maps (server-side key; restrict it to Geocoding API + Places API (New) in Google Cloud)
GOOGLE_MAPS_API_KEY=

# Email: console | smtp | memory
EMAIL_BACKEND=console
EMAIL_FROM=Event App <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Push notification API (coordinate payload contract with Kyrill): log | webhook
NOTIFICATION_BACKEND=log
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_API_KEY=

# Background jobs (reminders + automatic event deletion)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
EVENT_DEFAULT_DURATION_HOURS=3
EVENT_DELETE_GRACE_HOURS=1

RATE_LIMIT_ENABLED=true
